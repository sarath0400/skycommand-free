# Copy this to `.env` and fill in. NEVER commit the real .env.
# (These are the same kinds of settings skyCommand keeps in Azure Key Vault —
#  here they live as environment variables / GitHub & Render secrets.)

# Postgres from Neon (free) — Dashboard > Connection string. Keep ?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Turn on the boot-time self-migration
MIGRATE_ON_BOOT=true

# Google Gemini API key (free) — from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port the app listens on
PORT=5000
